# 阶段 4 生成层配置
# 用法：复制本文件为 .env，把 key 填进去。.env 不要提交到 Git。
#
# 获取密钥： https://platform.deepseek.com  →  API Keys  →  创建
# 计费参考： deepseek-chat 约 1 元 / 百万 token 输入。跑完 60 题评测不到 1 毛钱。
# 注意：即使问答走免费模型，评测脚本仍需要一把 DeepSeek 钥匙当"裁判"，
#       所以这一栏建议保留（跑正式评测时才用得上）。

DEEPSEEK_API_KEY=sk-你的密钥填这里
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------ 大脑后端
# LLM_BACKEND 决定问答用哪个"大脑"：
#   free     = 走免费云端 API（默认，智谱 GLM-4-Flash），不花钱、约 7 秒/题
#   deepseek = 走云端 API，答得最好，按 token 计费
#   local    = 走本机 llama-server，完全不花钱，但 8B 小模型答得比云端差
LLM_BACKEND=free

# 下面几项只在 LLM_BACKEND=local 时生效
# 先双击 启动本地大脑.bat 把服务起起来，再切这里
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=intern-s1-mini
LOCAL_LLM_API_KEY=sk-local
# 本地模型是否保留思维链：0=关（默认，快且稳），1=开
LOCAL_LLM_THINKING=0
# 本地服务的 JSON 模式：个别版本不支持时改成 0，改用提示词约束
LOCAL_LLM_JSON_MODE=1

# ------------------------------------------------------------------ 问答通道
# QA_MODE 决定网页/接口用哪套作答方式：
#   agent      = 智能体链路（默认）：规划 + 多路检索 + 自检回环，答得最全
#   procedural = 纯程序化抽取式：直接摘手册原文，免费、毫秒级、不吃显卡
QA_MODE=agent

# ------------------------------------------------------------------ 拒答复核
# 免费小模型有个毛病：证据明明在手，它却说"没依据"而要拒答。
# 复核用**检索分**做客观判据：模型称证据不足、但最高证据分 ≥ 本阈值时，
# 判定为保守误判 —— 先让它带纠正提示重答，仍不松口才退回照抄原文。
# 标定：被误拒的 Q06 top1=0.987，7 道真该拒的题 top1 全在 0.0009~0.1101，
# 取 0.5 两边各留 0.39 余量。设 0 可关闭复核。
REFUSE_CONFIRM_MIN=0.5

# ------------------------------------------------------------------ 免费大模型
# 问答大脑 + 程序化通道的兜底都用它。
# 智谱 GLM-4-Flash 免费：https://open.bigmodel.cn 注册 → API 密钥 → 新建
# 密钥形如 xxxxxxxx.yyyyyyyy，注意中间那个点不要漏。
FREE_LLM_ENABLED=1
FREE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FREE_LLM_MODEL=glm-4-flash
FREE_LLM_API_KEY=你的免费密钥填这里

# 程序化通道的兜底触发口径 FB_MODE（走 agent 通道时用不上）：
#   focus = 只兜底"结论不实在 **且** 条款没摘对条"的题（默认，60 题实测最划算）
#   weak  = 兜底所有"结论不实在"的题（更激进，实测反而略掉分）
#   cross = weak + 跨章题（一次问了好几件事的）
#   all   = 除程序化判定的拒答外，全部交给大模型（最像"纯 LLM"，最慢）
#   off   = 关闭兜底，退回纯程序化
FB_MODE=focus
# focus 口径的门槛：问题焦点在摘录条款里的覆盖率低于它才兜底
FB_FOCUS_COV=0.60

# ------------------------------------------------------------------ 检索编码后端
# 只影响「每次提问现场算问题向量 + 重排」那两步；文档侧的向量库照旧复用，
# 不会因为换后端而重建。两者的差别：
#   local = 本机 bge-m3 + bge-reranker-v2-m3（各 2.2 GB，吃显卡，最快）
#           → 本机开发用；需要 torch + sentence-transformers + models/ 目录
#   api   = 在线接口（硅基流动 SiliconFlow，免费档提供**同一对模型**）
#           → 部署到 Streamlit Cloud 用；不需要 torch，不占本机显存
#   留空 = 自动嗅探：models/bge-m3 存在就走 local，不存在就走 api
#          （Streamlit Cloud 上模型不随仓库上传，所以会自动落到 api）
EMBED_BACKEND=local
EMBED_API_BASE=https://api.siliconflow.cn/v1
# ⚠ 必须是 BAAI/bge-m3（1024 维）—— 向量库就是它算的，换别的模型整个库作废
# ⚠ 免费档的 ID **不带 Pro/ 前缀**：Pro/BAAI/bge-m3 是收费版（¥0.07/百万 tokens）
EMBED_API_MODEL=BAAI/bge-m3
EMBED_API_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 硅基流动控制台 → API 密钥。本地写这里；线上写进 Streamlit Cloud 的 Secrets
EMBED_API_KEY=

# ------------------------------------------------------------------ 访问保护
# 进入网页需要输入的口令。留空 = 不设门禁（仅供本机自测）。
# 换成什么口令都行，改完重启网页即可；别把口令贴到公开的地方。
ACCESS_CODE=SZPU666

# 提问限流 —— 已于 2026-10-15 按需求临时下线，现在是「来者即答」不拦频率。
# 下面这组参数留着不动，将来恢复限流时直接取消注释即可（限流代码备份在
# .trash_tmp/限流下线-20261015/）。原设计是两层：
#   会话级只管节奏（防一个人连点），全站级才保护免费额度（上游按并发/速率限）
# 单会话：每分钟最多几次 / 每天最多几次 / 两次提问的最小间隔（秒）
#RATE_PER_MIN=6
#RATE_PER_DAY=120
#RATE_MIN_GAP=2
# 全站：所有会话合计每分钟最多几次 / 同时作答的人数上限
#RATE_GLOBAL_PER_MIN=30
#RATE_MAX_CONCURRENT=4

# ------------------------------------------------------------------ 访问日志
# 每次提问都会写一行到 logs/access.log（本地，始终开）；
# 下面的开关控制是否同时同步到云库，方便你在别处查看。
LOG_ENABLED=1
CLOUD_LOG_ENABLED=1
CLOUD_ENDPOINT=https://szpu-handbook-qa.app.workbuddy.host
CLOUD_PUBLISHABLE_KEY=wbpk_5LyhZ0F5RWsUb899resz7e_VIoZzX64rPlPlexNlB5dPbg4fHrvRzsP
CLOUD_LOG_TABLE=qa_log
# 使用计数表：只记「谁何时问了一次」，**不含问题内容**，所以可以公开读 ——
# 使用统计看板就靠它出数字（限流下线后不再用于回填）
CLOUD_USAGE_TABLE=qa_usage
# 建议留言墙：学生写、所有人看，公开读 + 追加写（不给删改）
CLOUD_SUGGEST_TABLE=qa_suggestion

# ------------------------------------------------------------------ 使用看板
# 问答页底部「使用统计」入口的查看密钥，只有你知道（默认 9925）。
# 学生点那个入口只会看到一个要密钥的框，看不到任何数据。
ADMIN_CODE=9925
