# 阶段 4 生成层配置
# 用法：复制本文件为 .env，把 key 填进去。.env 不要提交到 Git。
#
# 获取密钥： https://platform.deepseek.com  →  API Keys  →  创建
# 计费参考： deepseek-chat 约 1 元 / 百万 token 输入。跑完 60 题评测不到 1 毛钱。
# 注意：即使问答走免费模型，评测脚本仍需要一把 DeepSeek 钥匙当"裁判"，
#       所以这一栏建议保留（跑正式评测时才用得上）。

DEEPSEEK_API_KEY=sk-你的密钥填这里
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------ 大脑后端
# LLM_BACKEND 决定问答用哪个"大脑"：
#   free     = 走免费云端 API（默认，智谱 GLM-4-Flash），不花钱、约 7 秒/题
#   deepseek = 走云端 API，答得最好，按 token 计费
#   local    = 走本机 llama-server，完全不花钱，但 8B 小模型答得比云端差
LLM_BACKEND=free

# 下面几项只在 LLM_BACKEND=local 时生效
# ⚠ 2026-10-19 起本机大模型方案已整体弃用（Intern-S1 量化权重与 llama.cpp
#   共 10.6 GB 已删除），下面这几行**留着只是备查，配了也跑不起来**。
#   要用请自行下载模型并按 git 历史还原「启动本地大脑.bat」。
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=intern-s1-mini
LOCAL_LLM_API_KEY=sk-local
# 本地模型是否保留思维链：0=关（默认，快且稳），1=开
LOCAL_LLM_THINKING=0
# 本地服务的 JSON 模式：个别版本不支持时改成 0，改用提示词约束
LOCAL_LLM_JSON_MODE=1

# ------------------------------------------------------------------ 拒答复核
# 免费小模型有个毛病：证据明明在手，它却说"没依据"而要拒答。
# 复核用**检索分**做客观判据：模型称证据不足、但最高证据分 ≥ 本阈值时，
# 判定为保守误判 —— 先让它带纠正提示重答，仍不松口才退回照抄原文。
# 标定：被误拒的 Q06 top1=0.987，7 道真该拒的题 top1 全在 0.0009~0.1101，
# 取 0.5 两边各留 0.39 余量。设 0 可关闭复核。
REFUSE_CONFIRM_MIN=0.5

# ------------------------------------------------------------------ 免费大模型
# 问答大脑（LLM_BACKEND=free 时走它）；模型彻底挂掉时的照抄兜底也用它。
# 智谱 GLM-4-Flash 免费：https://open.bigmodel.cn 注册 → API 密钥 → 新建
# 密钥形如 xxxxxxxx.yyyyyyyy，注意中间那个点不要漏。
#
# ⚠ 「永久免费、无 token 上限」说的是**不按 token 收费、不设总量上限**，
#   不等于不限速。免费档有速率限制（QPS/RPM，官方未公布具体数字），
#   短时间调用过密会收到「429 您的使用量已超出频率限制」。
#   一道题要调模型 3~4 次，几个人同时用就可能撞上，务必保留自动重试。
FREE_LLM_ENABLED=1
FREE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FREE_LLM_MODEL=glm-4-flash
FREE_LLM_API_KEY=你的免费密钥填这里
# 撞上 429 时的自动重试次数（SDK 层，指数退避约 2/4/8 秒）
# 设 0 = 不重试，直接把「响应繁忙，请稍后再试」显示给学生。
FREE_LLM_MAX_RETRIES=3

# ------------------------------------------------------------------ 检索编码后端
# 只影响「每次提问现场算问题向量 + 重排」那两步；文档侧的向量库照旧复用，
# 不会因为换后端而重建。两者的差别：
#   local = 本机 bge-m3 + bge-reranker-v2-m3（各 2.2 GB，吃显卡，最快）
#           → 需要 torch + sentence-transformers + 自己下载权重到 models/ 下
#   api   = 在线接口（模力方舟 moark，免费档提供**同一对模型**）
#           → 不需要 torch，不占本机显存
#   留空 = 自动嗅探：models/bge-m3 存在就走 local，不存在就走 api（最省心，推荐）
#
# ⚠ 默认给 api 而不是 local：**仓库不附带模型权重**（4 GB+ 不进版本库，
#   .gitignore 已排除 models/）。照抄 local 而本地又没下载模型的人，向量路会
#   加载失败、静默降级成纯关键词检索（页面出「本次检索打了折扣」黄条），
#   看起来"能跑"，其实检索质量掉一半。
EMBED_BACKEND=api
# 在线接口地址。两家都实测可用，**二选一**，填谁就把 ID 换成谁家的写法：
#   模力方舟 moark    EMBED_API_BASE=https://api.moark.com/v1
#                     模型 ID 不带前缀：bge-m3 / bge-reranker-v2-m3
#   硅基流动           EMBED_API_BASE=https://api.siliconflow.cn/v1
#                     模型 ID 带前缀：BAAI/bge-m3 / BAAI/bge-reranker-v2-m3
# 本项目线上用的是模力方舟（下两行按它填）。
EMBED_API_BASE=https://api.moark.com/v1
# ⚠ 必须是 1024 维的 bge-m3 —— 向量库就是它算的，换别的模型整个库作废
# ⚠ 硅基免费档的 ID **不带 Pro/ 前缀**：Pro/BAAI/bge-m3 是收费版（¥0.07/百万 tokens）
EMBED_API_MODEL=bge-m3
EMBED_API_RERANK_MODEL=bge-reranker-v2-m3
# 接口密钥：本地写这里；线上写进 Streamlit Cloud 的 Secrets（绝不进仓库）
EMBED_API_KEY=
# 单次调用超时（秒），留空用默认 8。正常一次编码约 0.8 秒、重排约 1.5 秒。
# 定得短是为了「连不上」时不干等：原来 30 秒×3 次重试＝90 秒/路，
# 线上实测一道题光等网络就 208 秒（2026-10-19）。现在连不上最多等约 17 秒就认输。
#EMBED_API_TIMEOUT=8

# ------------------------------------------------------------------ 访问保护
# 进入网页需要输入的口令。
# ⚠ **留空 = 一律挡住，不是放行**（防止线上配置漏填就敞开了免费额度）。
#    确实要免口令，必须显式写 ACCESS_CODE=off。
# ⚠ 本文件是模板，别把真口令写进来（仓库是公开的，这份文件会被提交）。
ACCESS_CODE=请改成你自己的口令

# 提问限流 —— 已于 2026-10-15 按需求临时下线，现在是「来者即答」不拦频率。
# 下面这组参数留着不动，将来恢复限流时直接取消注释即可。
# （原限流实现已从主链路移除，恢复时需按 git 历史 2026-10-15 之前的版本还原。）
# 原设计是两层：
#   会话级只管节奏（防一个人连点），全站级才保护免费额度（上游按并发/速率限）
# 单会话：每分钟最多几次 / 每天最多几次 / 两次提问的最小间隔（秒）
#RATE_PER_MIN=6
#RATE_PER_DAY=120
#RATE_MIN_GAP=2
# 全站：所有会话合计每分钟最多几次 / 同时作答的人数上限
#RATE_GLOBAL_PER_MIN=30
#RATE_MAX_CONCURRENT=4

# ------------------------------------------------------------------ 访问日志
# 每次提问都会写一行到 logs/access.log（本地，始终开）；
# 下面的开关控制是否同时同步到云库，方便你在别处查看。
LOG_ENABLED=1
CLOUD_LOG_ENABLED=1
CLOUD_ENDPOINT=https://szpu-handbook-qa.app.workbuddy.host
CLOUD_PUBLISHABLE_KEY=wbpk_5LyhZ0F5RWsUb899resz7e_VIoZzX64rPlPlexNlB5dPbg4fHrvRzsP
CLOUD_LOG_TABLE=qa_log
# 使用计数表：只记「谁何时问了一次」，**不含问题内容**，所以可以公开读 ——
# 使用统计看板就靠它出数字（限流下线后不再用于回填）
CLOUD_USAGE_TABLE=qa_usage
# 建议留言墙：学生写、所有人看，公开读 + 追加写（不给删改）
CLOUD_SUGGEST_TABLE=qa_suggestion

# ------------------------------------------------------------------ 使用看板
# 问答页底部「使用统计」入口的查看密钥，只有你知道。
# 学生点那个入口只会看到一个要密钥的框，看不到任何数据。
# ⚠ 本文件是模板，别把真密钥写进来（仓库是公开的）。
ADMIN_CODE=请改成你自己的看板密钥
